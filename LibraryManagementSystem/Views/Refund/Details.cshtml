@model LibraryManagementSystem.ClassLibrary.Models.BorrowRecord

@{
    ViewData["Title"] = "Refund Details";

decimal depositAmount =
    Model.SecurityDeposit > 0
        ? Model.SecurityDeposit
        : (Model.Book?.DepositAmount ?? 0);

    decimal totalCharges =
        Model.FineAmount +
        Model.DamageCharge +
        Model.LostBookCharge;
}

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                Refund Review
            </h4>
        </div>

        <div class="card-body">

            <h3 class="fw-bold">
                @Model.Book?.Title
            </h3>

            <hr />

            <div class="row">

                <div class="col-md-6">

                    <h5 class="mb-3">
                        Borrow Information
                    </h5>

                    <p>
                        <strong>Member Name:</strong>
                        @Model.Member?.Name
                    </p>

                    <p>
                        <strong>Borrow Type:</strong>

                        @if (Model.IsNonMemberBorrow)
                        {
                            <span class="badge bg-warning text-dark">
                                Non Member
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Member
                            </span>
                        }
                    </p>

                    <p>
                        <strong>Issued On:</strong>
                        @Model.IssuedOn.ToString("dd MMM yyyy")
                    </p>

                    <p>
                        <strong>Returned On:</strong>
                        @Model.ReturnedOn?.ToString("dd MMM yyyy")
                    </p>

                    <p>
                        <strong>Return Condition:</strong>
                        @Model.ReturnCondition
                    </p>

                    <p>
                        <strong>Late Days:</strong>
                        @Model.DaysLate
                    </p>

                    <p>
                        <strong>Status:</strong>
                        @Model.Status
                    </p>

                </div>

                <div class="col-md-6">

                    <div class="card border">

                        <div class="card-header bg-light">
                            Financial Summary
                        </div>

                        <div class="card-body">

                            @if (Model.IsNonMemberBorrow)
                            {
                                <p>
                                    Security Deposit:
                                    <strong>
                                        ₹@depositAmount
                                    </strong>
                                </p>

                                <p>
                                    Borrow Fee:
                                    <strong>
                                        ₹@Model.BorrowFee
                                    </strong>
                                </p>

                                <hr />

                                <p>
                                    Razorpay Payment Id:
                                    <strong>
                                        @(Model.RazorpayPaymentId ?? "N/A")
                                    </strong>
                                </p>

                                <p>
                                    Razorpay Order Id:
                                    <strong>
                                        @(Model.RazorpayOrderId ?? "N/A")
                                    </strong>
                                </p>
                            }

                            <p>
                                Late Fine:
                                <strong>
                                    ₹@Model.FineAmount
                                </strong>
                            </p>

                            <p>
                                Damage Charge:
                                <strong>
                                    ₹@Model.DamageCharge
                                </strong>
                            </p>

                            <p>
                                Lost Book Charge:
                                <strong>
                                    ₹@Model.LostBookCharge
                                </strong>
                            </p>

                            <p>
                                Extra Charge:
                                <strong class="text-danger">
                                    ₹@Model.ExtraCharge
                                </strong>
                            </p>

                            <hr />

                            <p>
                                Total Charges:
                                <strong class="text-danger">
                                    ₹@totalCharges
                                </strong>
                            </p>

                            <p>
                                Refund Amount:
                                <strong class="text-success">
                                    ₹@Model.RefundAmount
                                </strong>
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <hr />

            @if (Model.ReturnCondition == "Good")
            {
                <div class="alert alert-success">

                    <h5>Good Condition</h5>

                    Book returned in good condition.

                    <br />

                    Only applicable fines were deducted.

                </div>
            }

            @if (Model.ReturnCondition == "Damaged")
            {
                <div class="alert alert-warning">

                    <h5>Damaged Book</h5>

                    Damage charge applied.

                </div>
            }

            @if (Model.ReturnCondition == "Lost")
            {
                <div class="alert alert-danger">

                    <h5>Lost Book</h5>

                    Lost book replacement charge applied.

                </div>
            }

            @if (Model.IsNonMemberBorrow)
            {
                <div class="card mt-3 border-success">

                    <div class="card-header bg-success text-white">
                        Refund Calculation
                    </div>

                    <div class="card-body">

                        <p>
                            Deposit Paid:
                            <strong>
                                ₹@depositAmount
                            </strong>
                        </p>

                        <p>
                            Total Charges:
                            <strong>
                                ₹@totalCharges
                            </strong>
                        </p>

                        <p>
                            Refund Amount:
                            <strong class="text-success">
                                ₹@Model.RefundAmount
                            </strong>
                        </p>

                        <p>
                            Extra Charge:
                            <strong class="text-danger">
                                ₹@Model.ExtraCharge
                            </strong>
                        </p>

                    </div>

                </div>
            }
            else
            {
                <div class="alert alert-primary">

                    <h5>
                        Member Fine Summary
                    </h5>

                    Members do not pay security deposit.

                    <br />

                    Total Fine:

                    <strong>
                        ₹@totalCharges
                    </strong>

                </div>
            }

            <hr />

            @if (!Model.RefundProcessed
                        && Model.IsNonMemberBorrow
                        && Model.RefundAmount > 0
                        && Model.ExtraCharge == 0)
            {
                <form asp-action="ProcessRefund"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-success">

                        Process Razorpay Refund

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Back

                    </a>

                </form>
            }

            @if (Model.RefundProcessed)
            {
                <div class="alert alert-success mt-4">

                    <h5>
                        Refund Successfully Processed
                    </h5>

                    <table class="table table-bordered mt-3">

                        <tr>
                            <th>Refund Amount</th>
                            <td>₹@Model.RefundAmount</td>
                        </tr>

                        <tr>
                            <th>Refund Id</th>
                            <td>@Model.RazorpayRefundId</td>
                        </tr>

                        <tr>
                            <th>Refund Date</th>
                            <td>
                                @Model.RefundDate?.ToString("dd MMM yyyy hh:mm tt")
                            </td>
                        </tr>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
