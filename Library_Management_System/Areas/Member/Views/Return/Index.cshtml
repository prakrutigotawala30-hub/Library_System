@model LibraryManagementSystem.ClassLibrary.Models.BorrowRecord

@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
}


<style>

    body {
        background: var(--page-bg);
        color: var(--text);
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
    }

    .return-section {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px 20px;
    }

    .return-card {
        width: 100%;
        max-width: 900px;
        background: var(--card-gradient);
        border: 1px solid var(--soft-border);
        border-radius: 35px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(124,58,237,0.18);
        position: relative;
    }

    /* TOP AREA */

    .top-section {
        background: linear-gradient(135deg,#7c3aed,#9333ea);
        padding: 50px;
        position: relative;
        overflow: hidden;
    }

        .top-section::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
            top: -120px;
            right: -120px;
        }

        .top-section::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            bottom: -100px;
            left: -100px;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .return-icon {
        width: 90px;
        height: 90px;
        border-radius: 24px;
        background: rgba(255,255,255,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        margin-bottom: 25px;
        backdrop-filter: blur(8px);
    }

    .page-title {
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .page-subtitle {
        color: rgba(255,255,255,0.85);
        max-width: 550px;
        line-height: 1.7;
        font-size: 15px;
    }

    /* BODY */

    .card-body-custom {
        padding: 40px;
    }

    .book-container {
        background: var(--card-hover);
        border: 1px solid var(--soft-border);
        border-radius: 28px;
        padding: 30px;
    }

    .book-title {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .book-author {
        color: var(--text-muted);
        margin-bottom: 35px;
        font-size: 16px;
    }

    /* INFO GRID */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
        gap: 20px;
    }

    .info-card {
        background: var(--card);
        border: 1px solid var(--soft-border);
        border-radius: 22px;
        padding: 24px;
        transition: 0.3s;
    }

        .info-card:hover {
            transform: translateY(-5px);
            border-color: rgba(124,58,237,0.45);
            box-shadow: 0 10px 30px rgba(124,58,237,0.15);
        }

    .info-label {
        color: #9ca3af;
        font-size: 13px;
        margin-bottom: 10px;
    }

    .info-value {
        font-size: 18px;
        font-weight: 700;
    }

    /* ALERT */

    .alert-box {
        margin-top: 30px;
        background: rgba(220,38,38,0.12);
        border: 1px solid rgba(220,38,38,0.25);
        color: #fca5a5;
        padding: 20px;
        border-radius: 18px;
        line-height: 1.7;
    }


    .condition-box {
        margin-top: 30px;
    }

    .condition-label {
        display: block;
        margin-bottom: 10px;
        font-weight: 600;
        color: var(--text);
    }

    .condition-select {
        width: 100%;
        padding: 15px 18px;
        border-radius: 16px;
        border: 1px solid var(--soft-border);
        background: var(--card);
        color: var(--text);
        font-size: 15px;
        outline: none;
        transition: .3s;
    }

        .condition-select:focus {
            border-color: #7c3aed;
            box-shadow: 0 0 0 4px rgba(124,58,237,.2);
        }

        .condition-select option {
            background: #111827;
            color: white;
        }
    /* BUTTONS */

    .button-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 40px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .back-btn {
        color: #9ca3af;
        text-decoration: none;
        transition: 0.3s;
        font-weight: 500;
    }

        .back-btn:hover {
            color: white;
        }

    .confirm-btn {
        border: none;
        background: linear-gradient(90deg,#7c3aed,#9333ea);
        color: white;
        padding: 15px 34px;
        border-radius: 18px;
        font-weight: 700;
        font-size: 15px;
        transition: 0.3s;
        box-shadow: 0 15px 30px rgba(124,58,237,0.30);
    }

        .confirm-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 35px rgba(124,58,237,0.40);
        }

    /* RESPONSIVE */
    .form-label {
        display: block;
        color: var(--text);
        margin-bottom: 10px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        padding: 14px 18px;
        border-radius: 16px;
        border: 1px solid var(--soft-border);
        background: var(--card);
        color: var(--text);
        font-size: 15px;
    }

        .form-control:focus {
            outline: none;
            border-color: #7c3aed;
            box-shadow: 0 0 0 4px rgba(124,58,237,.15);
        }

    @@media(max-width:768px) {

        .top-section {
            padding: 35px 25px;
        }

        .card-body-custom {
            padding: 25px;
        }

        .page-title {
            font-size: 30px;
        }

        .book-title {
            font-size: 24px;
        }

        .button-group {
            flex-direction: column;
            align-items: stretch;
        }

        .confirm-btn {
            width: 100%;
        }
    }
    /* LIGHT THEME FIXES */

    body.light-mode .back-btn {
        color: var(--text-muted);
    }

        body.light-mode .back-btn:hover {
            color: var(--text);
        }

    body.light-mode .info-value,
    body.light-mode .book-title,
    body.light-mode .page-title {
        color: var(--text);
    }

    body.light-mode .return-section {
        background: var(--page-bg);
    }

</style>

<div class="return-section">

    <div class="return-card">

        <!-- TOP -->

        <div class="top-section">

            <div class="header-content">

                <div class="return-icon">
                    📚
                </div>

                <div class="page-title">
                    Return Book
                </div>

                <div class="page-subtitle">

                    Please review your borrowing information
                    carefully before confirming the return process.

                </div>

            </div>

        </div>

        <!-- BODY -->

        <div class="card-body-custom">

            <div class="book-container">

                <div class="book-title">
                    @Model.Book.Title
                </div>

                <div class="book-author">
                    by @Model.Book.Author.Name
                </div>

                <div class="info-grid">

                    <div class="info-card">

                        <div class="info-label">
                            Borrow Date
                        </div>

                        <div class="info-value">
                            @Model.IssuedOn.ToShortDateString()
                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Due Date
                        </div>

                        <div class="info-value">
                            @Model.DueDate.ToShortDateString()
                        </div>

                    </div>

                    <div class="info-card">

                        <div class="info-label">
                            Fine Per Day
                        </div>

                        <div class="info-value">
                            ₹@(Model.IsNonMemberBorrow ? 10 : 10)
                        </div>

                    </div>

                </div>

                @if (Model.DueDate < DateTime.Now)
                {
                    <div class="alert-box">

                        ⚠ This book is overdue.
                        Additional fine charges may apply
                        after confirming the return process.

                    </div>
                }

                <form asp-action="Confirm"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <!-- BOOK CONDITION -->

                    <div style="margin-top:30px;">

                        <label class="form-label">
                            Book Condition
                        </label>

                        <select id="conditionSelect"
                                name="returnCondition"
                                class="form-control"
                                required>

                            <option value="">
                                Select Book Condition
                            </option>

                            <option value="Good">
                                Good
                            </option>

                            <option value="Damaged">
                                Damaged
                            </option>

                            <option value="Lost">
                                Lost
                            </option>

                        </select>

                    </div>

                    <!-- CHARGE PREVIEW -->

                    <div id="chargePreview"
                         class="alert-box"
                         style="display:block;margin-top:20px;">

                        Select a book condition to see charges.

                    </div>

                    @if (Model.DueDate < DateTime.Now)
                    {
                        var lateDays =
                        Math.Max(0,
                        (DateTime.Now.Date - Model.DueDate.Date).Days);

                        <div class="alert-box">

                            <strong>
                                Late Days : @lateDays
                            </strong>

                            <br />

                            Fine Per Day :
                            ₹@(Model.IsNonMemberBorrow ? 10 : 10)

                        </div>
                    }

                    <div class="button-group">

                        <a asp-action="Index"
                           class="back-btn">

                            ← Back to Borrow History

                        </a>

                        <button type="submit"
                                class="confirm-btn">

                            Confirm Return

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
<script>

        let isNonMember =
        @(Model.IsNonMemberBorrow.ToString().ToLower());

    conditionSelect.addEventListener("change", function () {

        let condition = this.value;

        let lateDays =
            @(Math.Max(0,
                                                (DateTime.Now.Date - Model.DueDate.Date).Days));

        let finePerDay = 10;

        let deposit =
            @(Model.SecurityDeposit);

        let bookPrice =
    @(Model.Book?.DepositAmount ?? 0);

        let lateFine =
            lateDays * finePerDay;

        let html = "";

        // =========================
        // MEMBER
        // =========================

        if (!isNonMember)
        {
            if (condition === "Good")
            {
                html =
                    "<strong>Member Return</strong><br>" +
                    "Late Fine: ₹" + lateFine +
                    "<br><strong>Total Payable: ₹" +
                    lateFine + "</strong>";
            }

            else if (condition === "Damaged")
            {
                let damageCharge = 100;

                let total =
                    lateFine + damageCharge;

                html =
                    "<strong>Damaged Book</strong><br>" +
                    "Damage Charge: ₹100<br>" +
                    "Late Fine: ₹" + lateFine +
                    "<br><strong>Total Payable: ₹" +
                    total + "</strong>";
            }

            else if (condition === "Lost")
            {
                let total =
                    lateFine + bookPrice;

                html =
                    "<strong>Lost Book</strong><br>" +
                    "Book Price: ₹" + bookPrice +
                    "<br>Late Fine: ₹" + lateFine +
                    "<br><strong>Total Payable: ₹" +
                    total + "</strong>";
            }
        }

        // =========================
        // NON MEMBER
        // =========================

        else
        {
            if (condition === "Good")
            {
                let refund =
                    deposit - lateFine;

                if(refund < 0)
                    refund = 0;

                html =
                    "<table style='width:100%'>" +
                    "<tr><td>Deposit</td><td>₹" + deposit + "</td></tr>" +
                    "<tr><td>Late Fine</td><td>₹" + lateFine + "</td></tr>" +
                    "<tr><td><strong>Refund Given</strong></td><td><strong>₹" +
                    refund + "</strong></td></tr>" +
                    "</table>";
            }

            else if (condition === "Damaged")
            {
                let damageCharge = 100;

                let refund =
                    deposit -
                    lateFine -
                    damageCharge;

                if(refund < 0)
                    refund = 0;

                html =
                    "<table style='width:100%'>" +
                    "<tr><td>Deposit</td><td>₹" + deposit + "</td></tr>" +
                    "<tr><td>Late Fine</td><td>₹" + lateFine + "</td></tr>" +
                    "<tr><td>Damage Charge</td><td>₹100</td></tr>" +
                    "<tr><td><strong>Refund Given</strong></td><td><strong>₹" +
                    refund + "</strong></td></tr>" +
                    "</table>";
            }

            else if (condition === "Lost")
            {
                let remaining =
                    deposit - lateFine;

                let additionalCharge = 0;

                if (bookPrice > remaining)
                {
                    additionalCharge =
                        bookPrice - remaining;
                }

                html =
                    "<table style='width:100%'>" +
                    "<tr><td>Deposit</td><td>₹" + deposit + "</td></tr>" +
                    "<tr><td>Late Fine</td><td>₹" + lateFine + "</td></tr>" +
                    "<tr><td>Book Price</td><td>₹" + bookPrice + "</td></tr>" +
                    "<tr><td><strong>Additional Charge</strong></td><td><strong>₹" +
                    additionalCharge + "</strong></td></tr>" +
                    "</table>";
            }
        }

        chargePreview.innerHTML = html;
    });
</script>
