@model LibraryManagementSystem.ClassLibrary.Models.BorrowRecord

@{
    ViewData["Title"] = "Fine Payment";
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";

decimal payableAmount = Model.IsNonMemberBorrow
    ? Model.ExtraCharge
    : Model.FineAmount;

}

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<style>

    body {
        background: var(--page-bg);
        color: var(--text);
        font-family: 'Poppins', sans-serif;
    }

    .payment-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .payment-card {
        width: 100%;
        max-width: 900px;
        background: var(--card-gradient);
        border: 1px solid var(--soft-border);
        border-radius: 32px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(124,58,237,.18);
    }

    .payment-header {
        background: linear-gradient(135deg,#7c3aed,#9333ea);
        padding: 40px;
        text-align: center;
    }

    .payment-icon {
        width: 90px;
        height: 90px;
        margin: auto;
        border-radius: 24px;
        background: rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        margin-bottom: 20px;
    }

    .payment-title {
        color: white;
        font-size: 34px;
        font-weight: 800;
    }

    .payment-subtitle {
        color: rgba(255,255,255,.85);
        margin-top: 8px;
    }

    .payment-body {
        padding: 35px;
    }

    .book-title {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 30px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .info-box {
        background: var(--card);
        border: 1px solid var(--soft-border);
        border-radius: 20px;
        padding: 24px;
        text-align: center;
    }

    .info-label {
        color: var(--text-muted);
        font-size: 13px;
        margin-bottom: 10px;
    }

    .info-value {
        font-size: 22px;
        font-weight: 800;
    }

    .amount-box {
        background: rgba(239,68,68,.10);
        border: 1px solid rgba(239,68,68,.25);
        border-radius: 20px;
        padding: 25px;
        text-align: center;
        margin-bottom: 25px;
    }

    .amount-label {
        color: #fca5a5;
        margin-bottom: 10px;
    }

    .amount-value {
        font-size: 42px;
        font-weight: 900;
        color: #ef4444;
    }

    .warning-box {
        background: rgba(245,158,11,.10);
        border: 1px solid rgba(245,158,11,.25);
        color: #fbbf24;
        padding: 18px;
        border-radius: 16px;
        margin-bottom: 25px;
        text-align: center;
    }

    .pay-btn {
        width: 100%;
        border: none;
        border-radius: 18px;
        padding: 18px;
        font-size: 18px;
        font-weight: 700;
        color: white;
        background: linear-gradient(135deg,#7c3aed,#9333ea);
        box-shadow: 0 15px 30px rgba(124,58,237,.25);
        transition: .3s;
    }

        .pay-btn:hover {
            transform: translateY(-3px);
        }

    .secure-text {
        text-align: center;
        margin-top: 15px;
        color: var(--text-muted);
        font-size: 13px;
    }

</style>

<div class="payment-wrapper">

    <div class="payment-card">

        <div class="payment-header">

            <div class="payment-icon">
                💳
            </div>

            <div class="payment-title">
                Fine Payment
            </div>

            <div class="payment-subtitle">
                Complete payment to finish your return process
            </div>

        </div>

        <div class="payment-body">

            <div class="book-title">
                @Model.Book?.Title
            </div>

            <div class="info-grid">

                <div class="info-box">
                    <div class="info-label">
                        Return Condition
                    </div>

                    <div class="info-value">
                        @Model.ReturnCondition
                    </div>
                </div>

                <div class="info-box">
                    <div class="info-label">
                        Late Days
                    </div>

                    <div class="info-value">
                        @Model.DaysLate
                    </div>
                </div>

            </div>

            @if (Model.IsNonMemberBorrow)
            {
                <div class="info-grid">

                    <div class="info-box">
                        <div class="info-label">
                            Security Deposit
                        </div>

                        <div class="info-value">
                            ₹@Model.SecurityDeposit
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">
                            Total Charges
                        </div>

                        <div class="info-value">
                            ₹@Model.FineAmount
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">
                            Remaining Payable
                        </div>

                        <div class="info-value">
                            ₹@Model.ExtraCharge
                        </div>
                    </div>

                </div>
            }

            <div class="amount-box">

                <div class="amount-label">
                    Amount To Pay
                </div>

                <div class="amount-value">
                    ₹@payableAmount
                </div>

            </div>

            <div class="warning-box">

                @if (Model.IsNonMemberBorrow)
                {
                    <text>
                        ⚠ Your security deposit has already been adjusted.
                        Please pay only the remaining balance.
                    </text>
                }
                else
                {
                    <text>
                        ⚠ Payment is required before your return can be completed.
                    </text>
                }

            </div>

            <button id="rzp-button"
                    type="button"
                    class="pay-btn">

                Pay ₹@payableAmount

            </button>

            <div class="secure-text">
                Secure payment powered by Razorpay
            </div>

            <form id="payment-form"
                  asp-controller="Payment"
                  asp-action="FinePaymentSuccess"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="borrowId"
                       value="@Model.Id" />

                <input type="hidden"
                       id="razorpayPaymentId"
                       name="razorpayPaymentId" />

                <input type="hidden"
                       id="razorpayOrderId"
                       name="razorpayOrderId" />

                <input type="hidden"
                       id="razorpaySignature"
                       name="razorpaySignature" />

            </form>

        </div>

    </div>
</div>

<script>

    var options = {

        key: "@ViewBag.RazorpayKey",

        amount: "@((int)(payableAmount * 100))",

        currency: "INR",

        name: "Library Management System",

        description: "Book Fine Payment",

        order_id: "@ViewBag.OrderId",

        handler: function (response) {

            document.getElementById("razorpayPaymentId").value =
                response.razorpay_payment_id;

            document.getElementById("razorpayOrderId").value =
                response.razorpay_order_id;

            document.getElementById("razorpaySignature").value =
                response.razorpay_signature;

            document.getElementById("payment-form").submit();
        },

        theme: {
            color: "#7c3aed"
        }
    };

    var rzp = new Razorpay(options);

    document.getElementById("rzp-button")
        .onclick = function (e) {

            rzp.open();

            e.preventDefault();
        };

</script>
