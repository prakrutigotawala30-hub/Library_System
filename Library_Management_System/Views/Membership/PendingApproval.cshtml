@{
    ViewData["Title"] = "Membership Pending";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    body {
        background: #050816;
        color: #fff;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
    }

    .pending-page {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .pending-card {
        width: 100%;
        max-width: 750px;
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 24px;
        padding: 50px;
        text-align: center;
        box-shadow: 0 0 40px rgba(99,102,241,.25), 0 0 80px rgba(59,130,246,.12);
    }

    .pending-icon {
        width: 110px;
        height: 110px;
        margin: 0 auto 25px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(245, 158, 11, .15);
        border: 2px solid rgba(245, 158, 11, .3);
    }

        .pending-icon i {
            font-size: 55px;
            color: #f59e0b;
        }

    .pending-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .success-text {
        color: #22c55e;
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .pending-description {
        color: #cbd5e1;
        font-size: 1rem;
        line-height: 1.8;
        margin-bottom: 15px;
    }

    .info-box {
        margin-top: 30px;
        padding: 20px;
        border-radius: 16px;
        background: rgba(59,130,246,.08);
        border: 1px solid rgba(59,130,246,.15);
    }

        .info-box p {
            margin: 0;
            color: #dbeafe;
            font-size: .95rem;
        }

    .home-btn {
        margin-top: 30px;
        background: linear-gradient(135deg,#2563eb,#7c3aed);
        border: none;
        color: white;
        padding: 12px 30px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: .3s ease;
    }

        .home-btn:hover {
            transform: translateY(-3px);
            color: white;
            box-shadow: 0 10px 25px rgba(37,99,235,.35);
        }
</style>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="pending-page">

    <div class="pending-card">

        <div class="pending-icon">
            <i class="bi bi-hourglass-split"></i>
        </div>

        <h2 class="pending-title">
            Membership Request Submitted
        </h2>

        <div class="success-text">
            ✓ Payment Successful
        </div>

        <p class="pending-description">
            Your membership payment has been received successfully.
        </p>

        <p class="pending-description">
            Your request is currently waiting for administrator approval.
        </p>

        <div class="info-box">
            <p>
                Once approved, your account will automatically be upgraded
                from <strong>User</strong> to <strong>Member</strong> and
                you will gain access to all membership benefits.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="home-btn">
            Back To Home
        </a>

    </div>

</div>
