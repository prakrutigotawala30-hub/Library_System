@model Library_Management_System.ViewModels.MembershipRazorPayViewModel
@{
    ViewData["Title"] = "UPI Payment";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    body {
        background: radial-gradient(circle at top left, rgba(124, 58, 237, .18), transparent 30%), radial-gradient(circle at bottom right, rgba(217, 70, 239, .12), transparent 30%), #050816;
        font-family: 'Inter', sans-serif;
        color: white;
        margin: 0;
        padding: 0;
    }

    /* PAGE */
    .payment-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 60px 20px;
    }

    /* CARD */
    .payment-card {
        width: 100%;
        max-width: 680px;
        background: linear-gradient(180deg, #0f172a, #081120);
        border-radius: 34px;
        padding: 42px;
        border: 1px solid rgba(255, 255, 255, .08);
        text-align: center;
        box-shadow: 0 25px 70px rgba(0, 0, 0, .55);
        backdrop-filter: blur(18px);
    }

    /* TITLE */
    .title {
        font-size: 40px;
        font-weight: 900;
        margin-bottom: 8px;
        background: linear-gradient(135deg, #fff, #d8b4fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* PRICE */
    .price {
        font-size: 52px;
        font-weight: 900;
        color: #c084fc;
        margin-bottom: 28px;
    }

    /* PAYMENT METHODS */
    .payment-methods {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 26px;
    }

    .method-card {
        background: rgba(255, 255, 255, .04);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 18px;
        padding: 18px;
        cursor: pointer;
        transition: .25s ease;
    }

        .method-card:hover {
            transform: translateY(-4px);
            border-color: rgba(168, 85, 247, .35);
        }

        .method-card.active {
            border-color: #a855f7;
            background: rgba(168, 85, 247, .12);
            box-shadow: 0 12px 30px rgba(168, 85, 247, .25);
        }

    .method-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 10px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

        .method-icon img {
            width: 38px;
            height: 38px;
            object-fit: contain;
        }

    .method-card span {
        display: block;
        font-size: 14px;
        font-weight: 700;
        color: white;
    }

    /* DYNAMIC BOX */
    .dynamic-box {
        background: rgba(255, 255, 255, .03);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 18px;
    }

    .dynamic-title {
        font-size: 16px;
        font-weight: 800;
        margin-bottom: 12px;
        color: #e9d5ff;
    }

    /* INPUTS */
    .dynamic-input,
    .upload-input {
        width: 100%;
        padding: 14px;
        border-radius: 14px;
        background: #0b1220;
        border: 1px solid rgba(255, 255, 255, .08);
        color: white;
        outline: none;
        transition: .25s ease;
        font-size: 14px;
    }

        .dynamic-input:focus,
        .upload-input:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 4px rgba(168, 85, 247, .15);
        }

    .upload-input {
        margin-bottom: 18px;
    }

    /* QR BOX */
    .qr-box {
        background: white;
        padding: 16px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 20px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }

    /* UPI BOX */
    .upi-box {
        background: rgba(255, 255, 255, .03);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 18px;
    }

        .upi-box div:first-child {
            color: #9ca3af;
            margin-bottom: 6px;
            font-size: 13px;
        }

    .upi-id {
        color: #d8b4fe;
        font-size: 18px;
        font-weight: 800;
        word-break: break-word;
    }

    /* INFO */
    .info {
        color: #9ca3af;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 22px;
    }

    /* BUTTON */
    .pay-btn {
        width: 100%;
        border: none;
        padding: 16px;
        border-radius: 16px;
        background: linear-gradient(135deg, #7c3aed, #d946ef);
        color: white;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: .25s ease;
    }

        .pay-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(168, 85, 247, .3);
        }

    /* RESPONSIVE */
    @@media (max-width: 768px) {

        .payment-card {
            padding: 24px;
            border-radius: 26px;
        }

        .title {
            font-size: 30px;
        }

        .price {
            font-size: 40px;
        }

        .payment-methods {
            grid-template-columns: 1fr;
        }
    }
    /* =========================================
       LIGHT MODE
    ========================================= */

    body.light-mode {
        background: #f8fafc;
        color: #111827;
    }

        body.light-mode .payment-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            box-shadow: 0 20px 50px rgba(0,0,0,.08);
        }

        body.light-mode .title {
            background: linear-gradient(135deg,#7c3aed,#d946ef);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        body.light-mode .price {
            color: #7c3aed;
        }

        body.light-mode .info {
            color: #6b7280;
        }

        body.light-mode .method-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
        }

            body.light-mode .method-card span {
                color: #111827;
            }

            body.light-mode .method-card.active {
                background: rgba(124,58,237,.08);
                border-color: #7c3aed;
            }

        body.light-mode .method-icon {
            border: 1px solid #e5e7eb;
        }

        body.light-mode .dynamic-box {
            background: #ffffff;
            border: 1px solid #e5e7eb;
        }

        body.light-mode .dynamic-title {
            color: #7c3aed;
        }

        body.light-mode .dynamic-input,
        body.light-mode .upload-input {
            background: #ffffff;
            border: 1px solid #d1d5db;
            color: #111827;
        }

            body.light-mode .dynamic-input:focus,
            body.light-mode .upload-input:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 4px rgba(124,58,237,.12);
            }

        body.light-mode .upi-box {
            background: #ffffff;
            border: 1px solid #e5e7eb;
        }

            body.light-mode .upi-box div:first-child {
                color: #6b7280;
            }

        body.light-mode .upi-id {
            color: #7c3aed;
        }

        body.light-mode .pay-btn {
            background: linear-gradient(135deg,#7c3aed,#d946ef);
            color: #ffffff;
        }

            body.light-mode .pay-btn:hover {
                box-shadow: 0 15px 35px rgba(124,58,237,.20);
            }
</style>


<div class="payment-page">

    <div class="payment-card">

        <div class="title">
            Complete Payment
        </div>

        <div class="price">
            ₹@Model.Amount
        </div>

        <div class="info" style="margin-bottom:20px;">
            You will be redirected to Razorpay secure payment gateway
        </div>

        <!-- RAZORPAY PAYMENT FORM -->
        <form id="payment-form"
              asp-action="PaymentSuccess"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="razorpayPaymentId" id="razorpayPaymentId" />
            <input type="hidden" name="razorpayOrderId" id="razorpayOrderId" />
            <input type="hidden" name="razorpaySignature" id="razorpaySignature" />

            <button type="button"
                    id="rzp-button"
                    class="pay-btn">

                Pay Now ₹@Model.Amount

            </button>

        </form>

    </div>

</div>


<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>

    var options = {
        "key": "@Model.RazorpayKey",
        "amount": "@((int)(Model.Amount * 100))",
        "currency": "INR",
        "name": "Library Management System",
        "description": "@Model.MembershipType Membership",
        "order_id": "@Model.RazorpayOrderId",

        "handler": function (response) {

            document.getElementById("razorpayPaymentId").value =
                response.razorpay_payment_id;

            document.getElementById("razorpayOrderId").value =
                response.razorpay_order_id;

            document.getElementById("razorpaySignature").value =
                response.razorpay_signature;

            document.getElementById("payment-form").submit();
        },

        "theme": {
            "color": "#7c3aed"
        }
    };

    var rzp = new Razorpay(options);

    document.getElementById("rzp-button").onclick = function (e) {
        rzp.open();
        e.preventDefault();
    };

</script>
