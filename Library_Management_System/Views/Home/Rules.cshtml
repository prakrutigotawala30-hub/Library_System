@{
    ViewData["Title"] = "Rules";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: radial-gradient(circle at top right, rgba(124,58,237,0.18), transparent 35%), radial-gradient(circle at bottom left, rgba(236,72,153,0.10), transparent 35%), linear-gradient(135deg, #050816, #0b1120, #111827);
        color: #e5e7eb;
    }

    /* SECTION */
    .rules-section {
        min-height: 100vh;
        padding: 90px 0;
        background: radial-gradient(circle at top right, rgba(124,58,237,.18), transparent 35%), radial-gradient(circle at bottom left, rgba(236,72,153,.10), transparent 35%), linear-gradient(135deg, #050816, #0b1120, #111827);
    }

    /* HEADER */
    .rules-header {
        text-align: center;
        margin-bottom: 60px;
    }

        .rules-header h1 {
            font-size: 50px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -1px;
        }

        .rules-header p {
            font-size: 18px;
            color: #9ca3af;
            margin-top: 10px;
            line-height: 1.7;
        }

    /* CARD */
    .rule-card {
        height: 100%;
        padding: 28px 24px;
        border-radius: 24px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        backdrop-filter: blur(18px);
        box-shadow: 0 10px 30px rgba(0,0,0,.35);
        transition: all .3s ease;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .rule-card:hover {
            transform: translateY(-8px);
            border-color: rgba(139,92,246,.45);
            box-shadow: 0 20px 45px rgba(124,58,237,.25);
        }

        .rule-card h4 {
            font-size: 20px;
            font-weight: 700;
            color: #c084fc;
            margin-bottom: 14px;
            justify-content: center;
        }

        .rule-card p {
            color: #d1d5db;
            font-size: 15px;
            line-height: 1.8;
        }

        .rule-card::before {
            content: "";
            position: absolute;
            top: -50%;
            right: -50%;
            width: 150px;
            height: 150px;
            background: radial-gradient( rgba(124,58,237,.25), transparent 70% );
        }
        body.light-mode .rule-card {
    background: #ffffff !important;
    border: 1px solid #e5e7eb !important;
    box-shadow: 0 10px 25px rgba(0,0,0,.08);
}

body.light-mode .rule-card:hover {
    border-color: #7c3aed !important;
    box-shadow: 0 15px 35px rgba(124,58,237,.15);
}

body.light-mode .rule-card h4 {
    color: #7c3aed !important;
}

body.light-mode .rule-card p {
    color: #6b7280 !important;
}

body.light-mode .rule-card::before {
    background: radial-gradient(
        rgba(124,58,237,.12),
        transparent 70%
    );
}
        /* TITLE */
        .rule-card h4 {
            color: #c084fc;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* TEXT */
        .rule-card p {
            color: #d1d5db;
            line-height: 1.8;
            font-size: 15.5px;
            margin: 0;
        }

    /* GRID SPACING IMPROVEMENT */
    .row.g-4 > div {
        display: flex;
    }

    /* MOBILE */
    @@media (max-width: 768px) {

        .rules-section {
            padding: 60px 0;
        }

        .rules-header h1 {
            font-size: 36px;
        }

        .rules-header p {
            font-size: 16px;
        }

        .rule-card {
            padding: 24px;
        }

            .rule-card h4 {
                font-size: 16px;
            }
    }
    /* ===================================
       LIGHT MODE
    =================================== */

    body.light-mode .rules-section {
        background: radial-gradient(circle at top right, rgba(168,85,247,.15), transparent 35%), radial-gradient(circle at bottom left, rgba(99,102,241,.10), transparent 40%), linear-gradient(135deg,#faf5ff,#eef2ff);
    }

    body.light-mode .rules-header h1 {
        color: #111827 !important;
    }

    body.light-mode .rules-header p {
        color: #6b7280 !important;
    }

    body.light-mode .rule-card {
        background: #ffffff !important;
        border: 1px solid #e5e7eb !important;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

        body.light-mode .rule-card:hover {
            border-color: rgba(124,58,237,.35) !important;
            box-shadow: 0 15px 35px rgba(124,58,237,.12);
        }

        body.light-mode .rule-card h4 {
            color: #7c3aed !important;
        }

        body.light-mode .rule-card p {
            color: #6b7280 !important;
        }

        body.light-mode .rule-card::before {
            background: linear-gradient( 135deg, rgba(124,58,237,.04), transparent 60% );
        }
</style>

<section class="rules-section">

    <div class="container">

        <!-- HEADER -->

        <div class="rules-header">

            <h1>Library Rules</h1>

            <p>
                Please follow these guidelines for a better library experience
            </p>

        </div>

        <!-- RULES -->

        <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-4">

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>📚 Borrowing Limit</h4>

                    <p>
                        Students can borrow a maximum of 3 books at a time.
                    </p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>⏰ Late Fine</h4>

                    <p>
                        ₹5 fine will be charged per day after the due date.
                    </p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>🤫 Maintain Silence</h4>

                    <p>
                        Keep silence inside the library to maintain a peaceful environment.
                    </p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>📖 Book Care</h4>

                    <p>
                        Handle books carefully and avoid damaging library resources.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
